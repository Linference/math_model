# figures.mplstyle — 数学建模统一绘图风格
figure.figsize: 6, 4
figure.dpi: 120
savefig.dpi: 300
savefig.bbox: tight
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
axes.grid: True
grid.alpha: 0.3
grid.linestyle: --
lines.linewidth: 1.8
lines.markersize: 5
legend.frameon: True
legend.framealpha: 0.85
axes.prop_cycle: cycler('color', ['4C72B0','DD8452','55A868','C44E52','8172B3','937860'])
axes.spines.top: False
axes.spines.right: False
